{
  "name": "early-frontend",
  "version": "1.0.0-beta",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "build:base": "cd contracts/base && forge build",
    "export:abis": "node scripts/export-contract-abis.mjs",
    "test:app": "vitest run",
    "audit:x-proof": "node --no-warnings scripts/x-proof-conformance.mts",
    "test:e2e": "playwright test",
    "test:base": "cd contracts/base && forge test -vv",
    "test:zama": "pnpm --dir contracts/zama-private-receipt run test",
    "deploy:base": "node scripts/deploy-base.mjs",
    "test": "pnpm typecheck && pnpm test:app && pnpm test:base && pnpm test:zama && pnpm test:e2e"
  },
  "dependencies": {
    "@privy-io/node": "^0.27.0",
    "@privy-io/react-auth": "^3.35.1",
    "@reclaimprotocol/js-sdk": "^5.6.0",
    "@zama-fhe/sdk": "^1.0.0",
    "clsx": "^2.1.1",
    "ethers": "^6.15.0",
    "framer-motion": "^12.42.0",
    "geist": "^1.7.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^1.26.0",
    "next": "16.2.9",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "postcss": "^8.5.15",
    "solc": "0.8.26",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
